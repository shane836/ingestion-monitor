# Populate locally, never in chat or git. Use a random value for each token.
MONITOR_API_TOKEN=
CRE_HEARTBEAT_TOKEN=
# Fine-grained GitHub token: Actions write on the monitor repository;
# Actions read + Contents read on monitored repositories. No Contents write.
GITHUB_TOKEN=
PORT=8080
MONITOR_CONFIG=projects.json
MONITOR_STATE=state/incidents.json
# The repair workflow uses GitHub secrets OPENAI_API_KEY and RESEND_API_KEY.
# Its email destination and verified sender are repository variables
# MONITOR_EMAIL_TO and MONITOR_EMAIL_FROM. Do not use newsletter groups.
