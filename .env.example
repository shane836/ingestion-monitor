# Populate locally, never in chat or git. Use a random value for each token.
MONITOR_API_TOKEN=
CRE_HEARTBEAT_TOKEN=
# Optional read-only GitHub token for workflow checks; local clones use gh login.
GITHUB_TOKEN=
HOST=127.0.0.1
PORT=8080
MONITOR_CONFIG=projects.json
MONITOR_STATE=state/incidents.json
# Local repairs use the existing Codex CLI login; no OpenAI API key is required.
# Set this to the installed executable, not a shell alias.
CODEX_BIN=
# Local Resend notifications, separate from newsletter audiences.
MONITOR_EMAIL_ENABLED=false
RESEND_API_KEY=
MONITOR_EMAIL_FROM=
MONITOR_EMAIL_TO=
